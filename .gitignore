.DS_Store
node_modules/
build/
*.log
*.tgz

# Claude Code per-clone state: launch configs, worktrees, session caches.
# Per-user / per-machine — never shared.
.claude/

# User data — never commit. Contains full session transcripts, API keys leaked
# in conversations, file paths, project names. Generated locally per machine.
snapshots/
data/
# Exception: deterministic CI fixtures under fixtures/ must ship even though
# their tree mirrors the real snapshots/ layout. Negation re-includes the
# specific path; nothing outside fixtures/ is affected.
!fixtures/**/snapshots/
!fixtures/**/snapshots/**
dashboard.html
codex-dashboard.html
combined-dashboard.html
claude-web-dashboard.html
gemini-dashboard.html
goose-dashboard.html
cline-dashboard.html
redacted-*.html

# User-specific config — seeded from *.example.json on first run, then edited
# locally. Contains your subscription tier + start date + project aliases.
pricing.json
project-aliases.json

# Auto-fetched LiteLLM price cache — regenerable, per-machine, never commit.
pricing-cache.json

# Local-only secret config (claude.ai sessionKey)
.claude-stats-config.json

# Tauri build artifacts
src-tauri/target/
src-tauri/gen/
src-tauri/dist/*
!src-tauri/dist/splash.html
!src-tauri/dist/settings.html

# Tauri icons: only icon.svg is the source; everything else is regenerated by
# scripts/build-icons.mjs (locally + in CI). See .github/workflows/ci.yml for
# the CI build step.
#
# First line un-ignores the `icons/` dir itself, which gets caught by the
# global `Icon?` ignore (macOS Finder icon file) at the global Git ignore file
# under core.ignorecase=true. Without it, the negation on icon.svg below has
# no effect — git can't re-include a child if the parent dir is excluded.
!src-tauri/icons/
src-tauri/icons/*
!src-tauri/icons/icon.svg
src-tauri/icons/icon.iconset/

# Backup of git history before filter-repo rewrite — local-only, not for git
.git.bak/

# Private usage state and local credentials, including new tool formats.
pending-merges.json
cwd-manifest*.json
*.jsonl
*.sqlite
*.sqlite-*
*.db
*.db-*
.env
.env.*
!.env.example
*.pem
*.key
private/
exports/
.git.bak*/
*.bundle
# Only explicitly synthetic transcript fixtures belong in source control.
!fixtures/snapshot-fixture/snapshots/2026-01-01/projects/-tmp-test-myproj/*.jsonl
!fixtures/snapshot-with-secret/snapshots/2026-01-01/projects/-tmp-test-myproj/*.jsonl
# Historical usage-derived media stays local.
site/public/screenshot.png
